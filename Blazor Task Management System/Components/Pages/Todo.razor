@page "/todo"
@rendermode InteractiveServer
@inject TodoTaskService TaskService

<PageTitle>Tasks</PageTitle>

<section class="task-shell">
    <div class="task-header">
        <div>
            <p class="eyebrow">Application 08</p>
            <h1>Task Management</h1>
            <p class="task-subtitle">Create, update, complete, and delete tasks with every change stored in the local SQLite database.</p>
        </div>
        <div class="sync-badge">
            <span class="sync-dot"></span>
            SQLite connected
        </div>
    </div>

    @if (stats is not null)
    {
        <div class="metric-grid" aria-label="Task summary">
            <div class="metric-card">
                <span>Total</span>
                <strong>@stats.TotalTasks</strong>
            </div>
            <div class="metric-card">
                <span>Open</span>
                <strong>@stats.OpenTasks</strong>
            </div>
            <div class="metric-card">
                <span>Completed</span>
                <strong>@stats.CompletedTasks</strong>
            </div>
            <div class="metric-card alert-card">
                <span>Overdue</span>
                <strong>@stats.OverdueTasks</strong>
            </div>
        </div>
    }

    <div class="task-workspace">
        <section class="task-form-panel" aria-labelledby="task-form-title">
            <div class="panel-heading">
                <div>
                    <p class="eyebrow">Task editor</p>
                    <h2 id="task-form-title">@(editingId is null ? "New task" : "Update task")</h2>
                </div>
                @if (editingId is not null)
                {
                    <button class="icon-button ghost-button" type="button" title="Cancel edit" @onclick="CancelEdit">Cancel</button>
                }
            </div>

            <EditForm Model="draft" OnValidSubmit="SaveTaskAsync" FormName="todo-task-form">
                <DataAnnotationsValidator />

                <label class="field-label" for="task-title">Title</label>
                <InputText id="task-title" class="form-control task-input" @bind-Value="draft.Title" placeholder="Example: Submit assignment" />
                <ValidationMessage For="@(() => draft.Title)" />

                <label class="field-label" for="task-notes">Notes</label>
                <InputTextArea id="task-notes" class="form-control task-input task-notes" @bind-Value="draft.Description" placeholder="Optional details" />
                <ValidationMessage For="@(() => draft.Description)" />

                <div class="form-row">
                    <div>
                        <label class="field-label" for="task-priority">Priority</label>
                        <InputSelect id="task-priority" class="form-select task-input" @bind-Value="draft.Priority">
                            <option value="High">High</option>
                            <option value="Medium">Medium</option>
                            <option value="Low">Low</option>
                        </InputSelect>
                    </div>
                    <div>
                        <label class="field-label" for="task-due-date">Due date</label>
                        <InputDate id="task-due-date" class="form-control task-input" @bind-Value="draft.DueDate" />
                    </div>
                </div>

                <button class="primary-action" type="submit">
                    @(editingId is null ? "Add task" : "Save changes")
                </button>
            </EditForm>
        </section>

        <section class="task-list-panel" aria-labelledby="task-list-title">
            <div class="list-toolbar">
                <div>
                    <p class="eyebrow">Live tasks</p>
                    <h2 id="task-list-title">Database-backed list</h2>
                </div>
                <div class="filter-group" role="group" aria-label="Task filter">
                    @foreach (var item in filters)
                    {
                        <button class="filter-pill @(filter == item ? "active" : null)" type="button" @onclick="() => SetFilterAsync(item)">
                            @item
                        </button>
                    }
                </div>
            </div>

            @if (isLoading)
            {
                <div class="empty-state">Loading tasks...</div>
            }
            else if (tasks.Count == 0)
            {
                <div class="empty-state">No tasks match this view.</div>
            }
            else
            {
                <div class="task-list">
                    @foreach (var task in tasks)
                    {
                        <article class="task-card @(task.IsCompleted ? "completed" : null)">
                            <div class="task-card-main">
                                <button class="check-button @(task.IsCompleted ? "done" : null)" type="button" title="Toggle completion" @onclick="() => ToggleTaskAsync(task.Id)">
                                    @(task.IsCompleted ? "Done" : "Open")
                                </button>
                                <div>
                                    <div class="task-title-row">
                                        <h3>@task.Title</h3>
                                        <span class="priority-chip @task.Priority.ToLowerInvariant()">@task.Priority</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(task.Description))
                                    {
                                        <p class="task-description">@task.Description</p>
                                    }
                                    <div class="task-meta">
                                        <span>@GetDueLabel(task)</span>
                                        <span>Created @task.CreatedAt.ToString("MMM dd, yyyy")</span>
                                        @if (task.UpdatedAt is not null)
                                        {
                                            <span>Updated @task.UpdatedAt.Value.ToString("MMM dd, yyyy h:mm tt")</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="task-actions">
                                <button class="icon-button" type="button" title="Edit task" @onclick="() => StartEdit(task)">Edit</button>
                                <button class="icon-button danger-button" type="button" title="Delete task" @onclick="() => DeleteTaskAsync(task.Id)">Delete</button>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</section>

@code {
    private readonly string[] filters = ["All", "Open", "Completed", "Overdue"];
    private List<TodoTask> tasks = [];
    private TodoTaskFormModel draft = new();
    private TodoDashboardStats? stats;
    private int? editingId;
    private string filter = "All";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadTasksAsync();
    }

    private async Task SaveTaskAsync()
    {
        if (editingId is int id)
        {
            await TaskService.UpdateTaskAsync(id, draft);
        }
        else
        {
            await TaskService.CreateTaskAsync(draft);
        }

        CancelEdit();
        await LoadTasksAsync();
    }

    private void StartEdit(TodoTask task)
    {
        editingId = task.Id;
        draft = TodoTaskFormModel.FromTask(task);
    }

    private void CancelEdit()
    {
        editingId = null;
        draft = new TodoTaskFormModel();
    }

    private async Task ToggleTaskAsync(int id)
    {
        await TaskService.ToggleCompletionAsync(id);
        await LoadTasksAsync();
    }

    private async Task DeleteTaskAsync(int id)
    {
        await TaskService.DeleteTaskAsync(id);

        if (editingId == id)
        {
            CancelEdit();
        }

        await LoadTasksAsync();
    }

    private async Task SetFilterAsync(string selectedFilter)
    {
        filter = selectedFilter;
        await LoadTasksAsync();
    }

    private async Task LoadTasksAsync()
    {
        isLoading = true;
        tasks = await TaskService.GetTasksAsync(filter);
        stats = await TaskService.GetStatsAsync();
        isLoading = false;
    }

    private static string GetDueLabel(TodoTask task)
    {
        if (task.DueDate is null)
        {
            return "No due date";
        }

        var dueDate = task.DueDate.Value.Date;

        if (!task.IsCompleted && dueDate < DateTime.Today)
        {
            return $"Overdue since {dueDate:MMM dd}";
        }

        if (dueDate == DateTime.Today)
        {
            return "Due today";
        }

        return $"Due {dueDate:MMM dd, yyyy}";
    }
}
